# Copie para .env (o `npm run dev` lê o arquivo automaticamente)
PORT=3000
# Obrigatório em produção (16+ caracteres). Em desenvolvimento, se vazio, um segredo aleatório é gerado a cada início.
JWT_SECRET=
# Onde fica o banco SQLite
DATABASE_FILE=data/loja.sqlite
# Origens permitidas no CORS, separadas por vírgula (vazio = qualquer uma)
CORS_ORIGINS=
# Só na primeira execução (banco vazio): cria um administrador com estes dados
ADMIN_EMAIL=admin@loja.local
ADMIN_PASSWORD=
