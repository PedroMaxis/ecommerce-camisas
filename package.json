{
  "name": "ginga-api",
  "version": "3.0.0",
  "private": true,
  "description": "API da loja Ginga: blusas brasileiras (Express + SQLite)",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
